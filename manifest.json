{
    "manifest_version": 3,
    "name": "LexiLoop",
    "version": "0.2.0",
    "description": "Learn three practical English words every day and revise them with spaced repetition.",
    "permissions": [
        "storage",
        "alarms",
        "notifications"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "LexiLoop",
        "default_popup": "popup.html"
    }
}